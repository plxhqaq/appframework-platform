# 平台服务端部署环境变量模板
#
# 复制为 deploy/.env 后填写（.env 已被 .gitignore 忽略，不会入库）。
# 带冒号的变量在 compose 里是必填项，留空会直接启动失败——这是刻意的，
# 宁可起不来也不要带着默认口令上线。

# ── 数据库 ──────────────────────────────────────────────
# USE_EMBEDDED_POSTGRES=true  → deploy.sh 附加 docker-compose.postgres.yml，起一个容器库
# USE_EMBEDDED_POSTGRES=false → 复用现场已有的 PostgreSQL，下面几项就是它的连接参数
#   （不想手工改的话：./deploy/deploy.sh up --use-existing-pg "Host=...;Port=...;Database=...;Username=...;Password=***"）
USE_EMBEDDED_POSTGRES=true
POSTGRES_HOST=postgres
POSTGRES_DB=appframework_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=
# API 往哪连库。嵌入模式恒为容器内部的 postgres/5432，跟宿主机端口无关；
# 连宿主机自装的库要写 host.docker.internal，容器里的 127.0.0.1 是容器自己。
POSTGRES_PORT=5432
# 嵌入模式发布到宿主机 127.0.0.1 的端口，只给运维从宿主机 psql 直连排查用，API 不看它。
# 默认 5433 而不是 5432：现场机器上往往已经跑着一个 PG，撞了要等镜像拉完一分多钟才报错。
# 也可以部署时带 --pg-port <n>，脚本会写回这里。
POSTGRES_PUBLISH_PORT=5433

# ── API ────────────────────────────────────────────────
# 宿主机对外端口（容器内恒为 8080，改这里不影响应用自身的监听地址）。
# 8080 常被现场的 nginx / 别的 Web 占着；撞了脚本会在构建前就报出来并给出路。
# 也可以部署时带 --api-port <n>。
API_PORT=8080
# 对外绑定地址：0.0.0.0 = 客户端直接连这里；127.0.0.1 = 只交给本机反代，由反代对外。
# 也可以部署时带 --api-bind 127.0.0.1。
API_BIND_HOST=0.0.0.0
ASPNETCORE_ENVIRONMENT=Production

# ── 管理台（前端容器）──────────────────────────────────
# 默认起一个 nginx 容器：镜像里构建 dist，运行时同源反代 /api、/hubs 到 API。
# 现场机器上往往已经有一套 nginx 在代理别的应用，所以这份刻意不占 80/443，
# 也不抢 default_server（那会把别人的站点顶掉）。要并进现有站点就别起这个容器。
WEB_ENABLED=true
# 要不要 TLS。刷新令牌是 httpOnly Cookie，只有真的从 https 进来，API 才会按
# X-Forwarded-Proto 给它打上 Secure；纯 http = 口令与令牌在内网裸跑。
WEB_HTTPS=true
# http 发布端口。开 https 时它只留给设备通路（/api、/hubs 仍走明文，客户端没有配
# 自签信任，硬赶上 https 会直接连不上）与浏览器的 301 跳板。
WEB_HTTP_PORT=8081
# 浏览器实际访问的 https 端口（301 也跳这个）。想改成 443 之前先看宿主 nginx 占没占。
# 8081/8443 都是避让常用端口的默认值；撞了脚本会在开始构建之前就报出来，出路给三条：
#   换端口（--web-port / --web-https-port）、不要这个容器（--no-web）、只绑回环（--web-bind 127.0.0.1）。
WEB_HTTPS_PORT=8443
# 0.0.0.0 = 内网直接访问这里；127.0.0.1 = 只交给宿主反代对外。
WEB_BIND_HOST=0.0.0.0
# 证书目录（web.crt / web.key，容器只读挂载，私钥 600）。非 root 或那个路径建不出来时，
# 脚本会自动退到 deploy/certs/ 并把退后的路径写回这里。
# 现场 CA 签的证书也放这一对文件名里：脚本认出它不是自签，就只报到期时间、绝不再覆盖。
WEB_CERT_DIR=/var/lib/appframework-platform/certs
# 剩余有效期低于这个天数才重签（自签证书固定只有 397 天，靠人记「快到期了」靠不住，
# 所以 root + systemd 的机器上会自动装一个每天 06:17 检查一次的定时器）。
# 别调太大：每重签一次，所有浏览器记住的「继续前往」例外一起作废，每台机器都得再点一次。
WEB_SSL_RENEW_DAYS=30
# 自签证书的 CN，也是 SAN 里的第一个 DNS 项；留空 = 用主机名。SAN 还会自动带上本机内网 IP
# （浏览器认 SAN，不认 CN）。换过网段后 SAN 会对不上，脚本会提示 renew-cert --force。
WEB_SERVER_NAME=
# nginx 反代 API 的地址，默认走 compose 容器网络里的服务名。API 装在别的机器上时改这里，
# 例如 host.docker.internal:18888 或 10.0.0.5:8080。
WEB_API_UPSTREAM=api:8080
# 301 跳转时写进 Location 的对外 https 端口。只有反代又换了一次端口（外部 443 → 容器 8443）
# 才需要填；留空 = 用 WEB_HTTPS_PORT。
WEB_PUBLIC_HTTPS_PORT=

# ── 现场登录（单次密钥 / 扫码）─────────────────────────
# 二维码里写进去的管理台基址，必须是**手机浏览器能打开**的那个地址。
# 留空 = deploy.sh 按「WEB_SERVER_NAME 或本机内网 IP + 浏览器访问端口」推一个写回这里。
# 整站切换 http/https（up --no-https / --https）时，脚本会按当前模式改写这一项：
#   · --no-https → http://<主机>:<WEB_HTTP_PORT>，手机微信扫码不会弹自签证书警告
#   · --https    → https://<主机>:<WEB_HTTPS_PORT>，配受信任证书后同样无警告
# 外部域名/前置反代地址用 up --qr-base https://ops.example.com 钉住，避免被模式切换改写。
# 不能靠请求推导：nginx 转发的 Host 不带端口，推出来的地址手机扫开是连不上的。
QR_APPROVAL_URL_BASE=
# 两种临时登录可设置的最长时长（分钟）。默认 120 = 2 小时，够一个班次；
# 调小可以收紧现场令牌的存活窗口，服务端对超出上限的请求按上限钳制而不是报错。
SINGLE_LOGIN_MAX_MINUTES=120
QR_LOGIN_MAX_MINUTES=120

# ── 附件与安装包存储 ───────────────────────────────────
# 留空 = 具名卷 blobs（数据落在 docker 的卷目录里，默认够用）。
# 填宿主机绝对路径 = 改存这个目录，适合包体很大、要放数据盘的场景。
#   · 目录需对 uid 1001 可写；./deploy/deploy.sh up --blobs-dir /data/appframework-blobs 会建好并 chown
#   · 换位置不会自动搬既有文件，脚本会打印搬法
BLOB_STORAGE_HOST_PATH=

# ── 令牌 ────────────────────────────────────────────────
# 签名密钥：≥32 字符，生产环境请用 openssl rand -base64 48 生成后写入密钥管理系统
JWT_SIGNING_KEY=
JWT_ISSUER=appframework-platform
JWT_AUDIENCE=appframework
JWT_ACCESS_TOKEN_MINUTES=30
# 开发令牌端点：生产必须为 false（改 true 等于对外开放管理员令牌签发）
JWT_ALLOW_DEV_TOKEN_ENDPOINT=false

# ── 种子 ────────────────────────────────────────────────
# 首个管理员（admin）的引导口令：必须满足口令策略，首次登录会被强制修改。
# 留空 = 不创建管理员（内置角色与演示应用照常就绪），适合自建身份源的场景。
# 注意种子的口令只在 admin 账号**不存在**时写入：删过 .env 又留着数据卷、或已经改过密之后，
# 这里改什么都不影响库里那把哈希，会被挡在门外。强行对回（并作废该账号全部会话）：
#   bash deploy/deploy.sh reset-admin-password
SEED_ADMIN_PASSWORD=

# ── 授权（可选）─────────────────────────────────────────
# 授权快照/离线码的签发私钥：ECDSA P-256，PKCS#8 DER 再 Base64（单行）。
# 留空 = 整个授权模块 unmanaged：状态接口返回 unmanaged、离线码签发报 305。
# 私钥只走环境变量或 KMS，绝不入库、不入日志、不提交。
#
# 首装时 deploy.sh 会自动生成一对并写在这里（LICENSING_GENERATE_KEY=true，默认）：
#   · 不想启用授权：LICENSING_GENERATE_KEY=false，或 ./deploy/deploy.sh up --no-license-key
#   · 手工配好自己的私钥：脚本只补写公钥备查，**绝不重新生成私钥**（换钥会让已签发的
#     快照与离线码全部失效）
#   · 查看 keyId 与公钥指纹：./deploy/deploy.sh info（私钥全文需 --show-secrets）
#   · 手工生成（与脚本同口径）：
#       openssl ecparam -name prime256v1 -genkey -noout -out k.pem
#       openssl pkcs8 -topk8 -nocrypt -in k.pem -outform DER | base64 -w0
LICENSING_SIGNING_KEY_PKCS8=
# 公钥（SPKI Base64）：由私钥派生，服务端不读它，只是备查与客户端打包对账用（keyId =
# "lk-" + 它的 SHA-256 前 16 位）。客户端要内置同一把，否则客户端一律按 unmanaged 处理。
LICENSING_PUBLIC_KEY_SPKI_BASE64=
# 首装是否自动生成签发密钥（私钥非空时本项不起作用）。
LICENSING_GENERATE_KEY=true

# ── 可观测（可选）───────────────────────────────────────
# /metrics 默认开启且匿名可抓（Prometheus 文本格式）。留空 = 不校验；
# 设了值就必须带 X-Metrics-Token 头（或 Authorization: Bearer）。
# 公网可达时二选一：设 token，或在边缘只放内网。
METRICS_ENABLED=true
METRICS_SCRAPE_TOKEN=

# ── 部署拓扑（当前仅支持单副本）─────────────────────────
# 启动时用 PostgreSQL 会话级 advisory lock 抢占唯一实例锁：共用同一数据库的第二个实例
# 会直接启动失败。Webhook 投递没有行级认领，备份回执与 SignalR 推送是进程内状态。
# 只有实现了上述两项能力后才可关闭；关闭后多副本的重复投递/回执丢失由部署方负责。
DEPLOYMENT_REQUIRE_SINGLE_INSTANCE=true

# ── Webhook（可选）──────────────────────────────────────
# 投递器开关。关闭了单实例守卫的多副本部署必须只有一个副本为 true：
# 投递是「查出待发行 → 发 → 回写」，没有行级抢占，两个副本同开会重复投递。
WEBHOOKS_DISPATCHER_ENABLED=true
# 内网回调白名单：默认拒绝环回/私网/链路本地地址。主机名、*.通配子域、IP 或 CIDR，
# 逗号分隔。例如：10.20.0.0/16,hooks.internal.example.com
WEBHOOKS_ALLOWED_HOSTS=
