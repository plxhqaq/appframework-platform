# 平台管理台站点（http 版）：静态产物 + 与 API 同源的反向代理。
#
# 容器启动时 40-site.sh 用 envsubst 把 ${API_UPSTREAM} 换成 API 地址，再写进
# /etc/nginx/conf.d/default.conf；$host/$scheme 这些 nginx 自己的变量不在替换列表里，原样留着。
# 这份文件装在镜像里，改了要重新构建（重跑 bash deploy/deploy.sh up 就会重建；
# 带着 SKIP_BUILD=1 则沿用旧镜像里的站点）。
#
# 为什么必须同源代理，而不是让前端直接指向 API 端口：
# 刷新令牌是 httpOnly Cookie（前端读不到，靠 credentials: 'include' 带回），跨源部署要
# CORS 白名单 + SameSite=None 浏览器才肯在 AJAX 里带它。内网管理台用不着这份复杂度——
# 代价是这条链路和 API 绑在一起，API 没起来时管理台跟着白屏，health 动作会分别报出两者。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# antd + react 的 chunk 单块约 1.2MB（gzip 后 360KB），内网首屏也值得压。
# conf.d 里的文件是在 http 上下文中被 include 的，所以 gzip 写在这份文件里，
# 不必去改镜像自带那份 nginx.conf（那份一改就吃 docker 默认配置升级的风险）。
gzip on;
gzip_min_length 1k;
gzip_comp_level 5;
gzip_types text/css application/javascript application/json image/svg+xml;
gzip_vary on;

server {
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 2100m;   # 版本安装包从管理台直传（业务上限 ~2GB）

    # SignalR（/hubs/devices、/hubs/admin）要透传 Upgrade，否则只能一路退到长轮询；
    # 客户端平时直连 API 发布端口，走这条路的只是「浏览器和设备共用一个地址」的拓扑。
    location /hubs/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 安装包是从浏览器直传的几十上百 MB：nginx 默认先把整个请求体收进容器可写层
        # （/var/cache/nginx）再转给上游，等于白占一份磁盘，还让上传先等一遍落盘。
        # 关掉请求缓冲改成边收边转——上游就在同一个 docker 网络里，不需要靠缓冲做重试。
        proxy_request_buffering off;
        client_body_timeout 900s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 300s;
    }

    # 探针与接口文档跟着一起走，运维只记一个地址
    location = /healthz { proxy_pass http://${API_UPSTREAM}/healthz; }
    location = /ready   { proxy_pass http://${API_UPSTREAM}/ready; }
    location /scalar/  { proxy_pass http://${API_UPSTREAM}; }
    location /openapi/ { proxy_pass http://${API_UPSTREAM}; }

    # /metrics 刻意不代理：抓指标走 API 自己发布的端口，不在管理台入口上多开一个面。

    # 产物文件名带内容哈希，缺文件就是缺文件（多半是新旧版本混了），不该回落给 index.html
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location / {
        # 管理台是 history 路由（createBrowserRouter）：直接刷新 /identity 也得把 SPA 交给它
        try_files $uri $uri/ /index.html;
    }
}
