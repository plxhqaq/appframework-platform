<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    宿主：装配模块清单、认证授权、限流、健康检查、OpenAPI，并托管 React 静态资源。
    ApiProgram 暴露为 partial 供集成测试用 WebApplicationFactory 引用。
  -->
  <PropertyGroup>
    <RootNamespace>Platform.Api</RootNamespace>
    <UserSecretsId>platform-api</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Kernel\Platform.Kernel.csproj" />
    <ProjectReference Include="..\Platform.Contracts\Platform.Contracts.csproj" />
    <ProjectReference Include="..\Platform.Infrastructure\Platform.Infrastructure.csproj" />
    <ProjectReference Include="..\Platform.Workers\Platform.Workers.csproj" />
    <ProjectReference Include="..\Platform.Modules.Apps\Platform.Modules.Apps.csproj" />
    <ProjectReference Include="..\Platform.Modules.Identity\Platform.Modules.Identity.csproj" />
    <ProjectReference Include="..\Platform.Modules.Versions\Platform.Modules.Versions.csproj" />
    <ProjectReference Include="..\Platform.Modules.Licensing\Platform.Modules.Licensing.csproj" />
    <ProjectReference Include="..\Platform.Modules.Backups\Platform.Modules.Backups.csproj" />
    <ProjectReference Include="..\Platform.Modules.Devices\Platform.Modules.Devices.csproj" />
    <ProjectReference Include="..\Platform.Modules.Documents\Platform.Modules.Documents.csproj" />
    <ProjectReference Include="..\Platform.Modules.Webhooks\Platform.Modules.Webhooks.csproj" />
  </ItemGroup>

  <!--
    产品版本 = VersionPrefix + git 提交数（第四段），例如 1.0.0.13。
    契约包/客户端 SDK 走各自的 PlatformContractsVersion / PlatformClientVersion，不受影响。
    没有 git 元数据（源码包、镜像内构建）时提交数退化为 0，仍保持四段可解析。
  -->
  <Target Name="ApplyGitCommitVersion" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <PropertyGroup>
      <GitCommitCount Condition="'$(GitCommitCount)' == ''">0</GitCommitCount>
    </PropertyGroup>
    <Exec
      Command="git rev-list --count HEAD"
      WorkingDirectory="$(MSBuildProjectDirectory)/../.."
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="low"
      Condition="'$(GitCommitCount)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCountOutput" />
    </Exec>
    <PropertyGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitCommitCountOutput.Trim())', '^[0-9]+$'))">
      <GitCommitCount>$(_GitCommitCountOutput.Trim())</GitCommitCount>
    </PropertyGroup>
    <PropertyGroup>
      <Version>$(VersionPrefix).$(GitCommitCount)</Version>
      <FileVersion>$(VersionPrefix).$(GitCommitCount)</FileVersion>
      <InformationalVersion>$(VersionPrefix).$(GitCommitCount)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- 设计时迁移工具要求启动工程引用 Design；运行时不使用。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

</Project>
