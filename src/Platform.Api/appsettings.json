{
  "ConnectionStrings": {
    "Platform": ""
  },
  "Jwt": {
    "Issuer": "appframework-platform",
    "Audience": "appframework",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "AllowDevTokenEndpoint": false
  },
  "AppContextGuard": {
    "CacheSeconds": 30
  },
  "BlobStorage": {
    "RootPath": "data/blobs",
    "TempDirectoryName": ".tmp",
    "BufferSize": 81920
  },
  "Database": {
    "AutoMigrate": false
  },
  "Deployment": {
    "RequireSingleInstance": true
  },
  "Argon2": {
    "DegreeOfParallelism": 8,
    "MemorySizeKiB": 65536,
    "Iterations": 4,
    "HashLength": 64,
    "SaltLength": 64
  },
  "LoginThrottle": {
    "MaxFailuresBeforeLockout": 10,
    "LockoutMinutes": 15,
    "TrackingWindowMinutes": 15
  },
  "SingleLogin": {
    "DefaultDurationMinutes": 30,
    "MaxDurationMinutes": 120,
    "MaxAttempts": 5
  },
  "QrLogin": {
    "ExpireMinutes": 10,
    "DefaultDurationMinutes": 30,
    "MaxDurationMinutes": 120,
    "ApprovalUrlBase": ""
  },
  "Identity": {
    "Cleanup": {
      "BatchSize": 500,
      "RefreshTokenRetentionDays": 7,
      "SingleKeyRetentionHours": 24,
      "QrSessionRetentionHours": 24,
      "LoginThrottleRetentionHours": 24
    }
  },
  "Versions": {
    "UploadTicketMinutes": 30,
    "MaxFileSizeBytes": 4294967296,
    "MaxPackageSizeBytes": 4294967296,
    "MaxFilesPerArtifact": 50000,
    "MaxExtractedBytesPerPackage": 21474836480,
    "MaxZipEntries": 100000,
    "MaxCompressionRatio": 200,
    "MinFreeDiskBytes": 5368709120,
    "RetainRawPackage": true,
    "RequirePackageFileNameMatch": false,
    "PackageFileNamePatterns": "Setup-{channel}-{version}{ext},Update-{channel}-{version}{ext},AppFramework.Updater-{version}{ext}",
    "IngestionConcurrency": 1,
    "IngestionLockMinutes": 10,
    "IngestionEnabled": true,
    "IngestionPollSeconds": 10,
    "IngestionMaxAttempts": 3,
    "BlobSweepEnabled": true,
    "BlobSweepDryRun": true,
    "BlobSweepGraceHours": 48,
    "BlobSweepBatchSize": 500,
    "FailedPackageRetentionDays": 30,
    "ArchivedReleaseRetentionDays": 0,
    "AudienceAutoCreateChannels": false
