  "Licensing": {
    "MaxLicenseDays": 3650
  },
  "Backups": {
    "InlineMaxBytes": 65536,
    "MaxPayloadBytes": 67108864,
    "PushAckTimeoutSeconds": 60,
    "CleanupGraceMinutes": 30,
    "DefaultMaxVersions": 50
  },
  "Documents": {
    "MaxFileSizeBytes": 209715200,
    "CleanupGraceMinutes": 30
  },
  "Webhooks": {
    "BaseDelaySeconds": 30,
    "MaxDelaySeconds": 3600,
    "MaxAttempts": 8,
    "TimeoutSeconds": 10,
    "DispatchIntervalSeconds": 15,
    "BatchSize": 50,
    "DispatcherEnabled": true,
    "DeliveryRetentionDays": 30,
    "AllowedHosts": ""
  },
  "Metrics": {
    "Enabled": true,
    "ScrapeToken": ""
  },
  "Seed": {
    "Enabled": true,
    "AdminUserName": "admin",
    "AdminPassword": "",
    "AdminDisplayName": "平台管理员",
    "DemoAppKey": "demo",
    "DemoAppName": "演示应用"
  },
  "Workers": {
    "Maintenance": {
      "IntervalSeconds": 600,
      "IdempotencyRetentionHours": 24,
      "AuditRetentionDays": 180,
      "BatchSize": 5000
    },
    "Retention": {
      "IntervalSeconds": 600
    }
  },
  "RateLimits": {
    "SingleLoginRedeemPerMinute": 10,
    "QrSessionPerMinute": 60,
    "VersionsUploadTicketPerMinute": 60,
    "VersionsPackageFinalizePerMinute": 30
