{
  "ConnectionStrings": {
    "Platform": ""
  },
  "Jwt": {
    "Issuer": "appframework-platform",
    "Audience": "appframework",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "AllowDevTokenEndpoint": false
  },
  "BlobStorage": {
    "RootPath": "data/blobs",
    "TempDirectoryName": ".tmp",
    "BufferSize": 81920
  },
  "Database": {
    "AutoMigrate": false
  },
  "Argon2": {
    "DegreeOfParallelism": 8,
    "MemorySizeKiB": 65536,
    "Iterations": 4,
    "HashLength": 64,
    "SaltLength": 64
  },
  "LoginThrottle": {
    "MaxFailuresBeforeLockout": 10,
    "LockoutMinutes": 15,
    "TrackingWindowMinutes": 15
  },
  "SingleLogin": {
    "DefaultDurationMinutes": 30,
    "MaxDurationMinutes": 60,
    "MaxAttempts": 5
  },
  "QrLogin": {
    "ExpireMinutes": 10,
    "DefaultDurationMinutes": 30,
    "MaxDurationMinutes": 60
  },
  "Versions": {
    "UploadTicketMinutes": 30,
    "MaxFileSizeBytes": 4294967296,
    "MaxFilesPerArtifact": 50000
  },
  "Seed": {
    "Enabled": true,
    "AdminUserName": "admin",
    "AdminPassword": "",
    "AdminDisplayName": "平台管理员",
    "DemoAppKey": "demo",
    "DemoAppName": "演示应用"
  },
  "Workers": {
    "Maintenance": {
      "IntervalSeconds": 600,
      "IdempotencyRetentionHours": 24,
      "AuditRetentionDays": 180,
      "BatchSize": 5000
    }
  },
  "RateLimits": {
    "SingleLoginRedeemPerMinute": 10,
    "QrSessionPerMinute": 60
  },
  "AllowedHosts": "*"
}
