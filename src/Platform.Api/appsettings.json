{
  "ConnectionStrings": {
    "Platform": ""
  },
  "Jwt": {
    "Issuer": "appframework-platform",
    "Audience": "appframework",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30,
    "AllowDevTokenEndpoint": false
  },
  "BlobStorage": {
    "RootPath": "data/blobs",
    "TempDirectoryName": ".tmp",
    "BufferSize": 81920
  },
  "Database": {
    "AutoMigrate": false
  },
  "Workers": {
    "Maintenance": {
      "IntervalSeconds": 600,
      "IdempotencyRetentionHours": 24,
      "AuditRetentionDays": 180,
      "BatchSize": 5000
    }
  },
  "AllowedHosts": "*"
}
