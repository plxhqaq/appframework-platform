<?xml version="1.0" encoding="utf-8"?>
<!--
  源锁定：nuget.org + 本仓 artifacts/packages（契约包 AppFramework.Platform.Contracts 的发布/消费目录）。
  客户端仓库以精确版本 pin 该包，因此这里的版本号就是跨端契约的版本号。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="appframework-local" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="appframework-local">
      <package pattern="AppFramework.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
